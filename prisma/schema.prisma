// Prisma Schema Configuration for NEXORA
// Compatible with Prisma 6.19.3 and PostgreSQL 17

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicRole {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
  STAFF
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String
  phone         String?
  isActive      Boolean      @default(true) @map("is_active")
  emailVerified DateTime?    @map("email_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  memberships       Membership[]
  sessions          Session[]
  appointments      Appointment[]
  consultations     Consultation[]        @relation("DoctorConsultations")
  prescriptions     Prescription[]        @relation("DoctorPrescriptions")
  consultationVersions ConsultationVersion[] @relation("DoctorConsultationVersions")
  amendedVersions   ConsultationVersion[]   @relation("AmendedByVersions")
  clinicalAuditLogs ClinicalAuditLog[]
  createdInvoices   Invoice[]             @relation("InvoiceCreatedBy")
  receivedPayments  Payment[]             @relation("PaymentReceivedBy")
  notificationLogs  NotificationLog[]     @relation("NotificationCreatedBy")

  @@index([email])
  @@map("users")
}

model Clinic {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  country     String       @default("IN") // "IN" for India, "NP" for Nepal
  currency    String       @default("INR") // "INR" or "NPR"
  phone       String?
  address     String?
  taxLabel    String?      @map("tax_label") // e.g. "GSTIN", "PAN", "VAT"
  taxNumber   String?      @map("tax_number") // Optional tax/registration number
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships       Membership[]
  sessions          Session[]
  patients          Patient[]
  appointments      Appointment[]
  consultations     Consultation[]
  observations      Observation[]
  diagnoses            Diagnosis[]
  prescriptions        Prescription[]
  consultationVersions ConsultationVersion[]
  clinicalAuditLogs    ClinicalAuditLog[]
  invoices             Invoice[]
  invoiceSequences     InvoiceSequence[]
  payments             Payment[]
  notificationSetting  ClinicNotificationSetting?
  notificationLogs     NotificationLog[]
  secureLinks          SecureDocumentLink[]

  @@index([slug])
  @@map("clinics")
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Patient {
  id               String             @id @default(uuid())
  clinicId         String             @map("clinic_id")
  mrn              String             // Medical Record Number / Patient Identifier within clinic (e.g. NX-0001)
  name             String
  dateOfBirth      DateTime?          @map("date_of_birth")
  gender           String?            // MALE, FEMALE, OTHER
  phone            String?
  email            String?
  address          String?
  emergencyContact String?            @map("emergency_contact")
  bloodGroup       String?            @map("blood_group")
  allergies        String?
  notes            String?
  smsConsent       Boolean            @default(false) @map("sms_consent")
  whatsappConsent  Boolean            @default(false) @map("whatsapp_consent")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  clinic           Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  consultations    Consultation[]
  observations        Observation[]
  diagnoses           Diagnosis[]
  prescriptions       Prescription[]
  consultationVersions ConsultationVersion[]
  clinicalAuditLogs   ClinicalAuditLog[]
  invoices            Invoice[]
  notifications       NotificationLog[]
  secureLinks         SecureDocumentLink[]

  @@unique([clinicId, mrn])
  @@index([clinicId])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@index([clinicId, isActive])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(uuid())
  clinicId        String            @map("clinic_id")
  patientId       String            @map("patient_id")
  doctorId        String?           @map("doctor_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  cancelledReason String?           @map("cancelled_reason")
  checkedInAt     DateTime?         @map("checked_in_at")
  inProgressAt    DateTime?         @map("in_progress_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  consultations   Consultation[]
  invoices        Invoice[]
  notifications   NotificationLog[]

  @@index([clinicId])
  @@index([clinicId, startTime])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([doctorId, startTime])
  @@map("appointments")
}

model Membership {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  clinicId  String     @map("clinic_id")
  role      ClinicRole @default(STAFF)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
  @@map("memberships")
}

model Session {
  id             String    @id @default(uuid())
  tokenHash      String    @unique @map("token_hash") // SHA-256 hash of raw session token
  userId         String    @map("user_id")
  activeClinicId String?   @map("active_clinic_id")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClinic   Clinic?   @relation(fields: [activeClinicId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model AuthRateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  attempts  Int      @default(1)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key, resetAt])
  @@map("auth_rate_limits")
}

enum ConsultationStatus {
  DRAFT
  FINALIZED
  AMENDED
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
  CANCELLED
}

model Consultation {
  id              String             @id @default(uuid())
  clinicId        String             @map("clinic_id")
  patientId       String             @map("patient_id")
  doctorId        String             @map("doctor_id")
  appointmentId   String?            @map("appointment_id")
  status          ConsultationStatus @default(DRAFT)
  version         Int                @default(1)

  // SOAP Notes
  subjective      String?            // Symptoms, history of present illness, patient complaints
  objective       String?            // Physical examination, clinical findings
  assessment      String?            // Clinical assessment, clinical rationale
  plan            String?            // Treatment plan, advice, follow-up instructions

  finalizedAt     DateTime?          @map("finalized_at")
  amendedAt       DateTime?          @map("amended_at")
  amendmentReason String?            @map("amendment_reason")

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User               @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: Restrict)
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  observations    Observation[]
  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  versions        ConsultationVersion[]
  auditLogs       ClinicalAuditLog[]
  invoices        Invoice[]

  @@index([clinicId])
  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@index([doctorId])
  @@index([appointmentId])
  @@map("consultations")
}

model Observation {
  id               String        @id @default(uuid())
  clinicId         String        @map("clinic_id")
  patientId        String        @map("patient_id")
  consultationId   String        @map("consultation_id")
  version          Int           @default(1)
  isCurrent        Boolean       @default(true) @map("is_current")

  systolicBp       Int?          @map("systolic_bp")       // mmHg (e.g. 120)
  diastolicBp      Int?          @map("diastolic_bp")      // mmHg (e.g. 80)
  heartRate        Int?          @map("heart_rate")        // bpm (e.g. 72)
  temperature      Float?                                  // e.g. 98.6
  temperatureUnit  String?       @default("F") @map("temperature_unit") // "F" or "C"
  respiratoryRate  Int?          @map("respiratory_rate")  // breaths/min (e.g. 16)
  oxygenSaturation Float?        @map("oxygen_saturation") // SpO2 % (e.g. 98.5)
  height           Float?                                  // e.g. 172.0
  heightUnit       String?       @default("cm") @map("height_unit") // "cm" or "in"
  weight           Float?                                  // e.g. 68.5
  weightUnit       String?       @default("kg") @map("weight_unit") // "kg" or "lbs"
  bmi              Float?                                  // body mass index
  notes            String?

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation     Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
  @@index([consultationId, isCurrent])
  @@map("observations")
}

model Diagnosis {
  id              String        @id @default(uuid())
  clinicId        String        @map("clinic_id")
  patientId       String        @map("patient_id")
  consultationId  String        @map("consultation_id")
  version         Int           @default(1)
  isCurrent       Boolean       @default(true) @map("is_current")

  name            String        // Diagnosis description
  codeSystem      String?       @map("code_system") // e.g. "ICD-10", "CUSTOM"
  code            String?       // e.g. "E11.9"
  type            DiagnosisType @default(PRIMARY)
  clinicalStatus  String?       @default("ACTIVE") @map("clinical_status") // "ACTIVE", "RESOLVED", "CHRONIC"
  notes           String?

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation    Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
  @@index([consultationId, isCurrent])
  @@map("diagnoses")
}

model Prescription {
  id              String             @id @default(uuid())
  clinicId        String             @map("clinic_id")
  patientId       String             @map("patient_id")
  consultationId  String?            @map("consultation_id")
  doctorId        String             @map("doctor_id")
  status          PrescriptionStatus @default(ACTIVE)
  version         Int                @default(1)
  notes           String?            // General advice, dietary precautions

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation    Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  doctor          User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Restrict)

  items           PrescriptionItem[]
  notifications   NotificationLog[]

  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String       @id @default(uuid())
  prescriptionId  String       @map("prescription_id")
  medicationName  String       @map("medication_name")
  strength        String?      // e.g. "500 mg"
  route           String?      // e.g. "ORAL", "TOPICAL"
  frequency       String       // e.g. "1-0-1", "Twice daily"
  duration        String       // e.g. "5 days", "1 month"
  quantity        String?      // e.g. "10 tablets"
  instructions    String?      // e.g. "After meals"
  createdAt       DateTime     @default(now()) @map("created_at")

  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

model ClinicalAuditLog {
  id              String       @id @default(uuid())
  clinicId        String       @map("clinic_id")
  patientId       String       @map("patient_id")
  consultationId  String?      @map("consultation_id")
  actorId         String       @map("actor_id")
  actorName       String       @map("actor_name")
  actorRole       ClinicRole   @map("actor_role")
  recordType      String       @map("record_type") // "CONSULTATION", "PRESCRIPTION", "OBSERVATION", "DIAGNOSIS"
  recordId        String       @map("record_id")
  action          String       // "CREATE", "UPDATE", "FINALIZE", "AMEND", "CANCEL"
  details         String?      // Structured safe summary
  createdAt       DateTime     @default(now()) @map("created_at")

  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  actor           User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId])
  @@index([consultationId])
  @@index([recordId])
  @@index([actorId])
  @@map("clinical_audit_logs")
}

model ConsultationVersion {
  id                    String             @id @default(uuid())
  consultationId        String             @map("consultation_id")
  clinicId              String             @map("clinic_id")
  patientId             String             @map("patient_id")
  doctorId              String             @map("doctor_id")
  versionNumber         Int                @map("version_number")
  status                ConsultationStatus

  subjective            String?
  objective             String?
  assessment            String?
  plan                  String?

  observationsSnapshot  Json?              @map("observations_snapshot")
  diagnosesSnapshot     Json?              @map("diagnoses_snapshot")
  prescriptionsSnapshot Json?              @map("prescriptions_snapshot")

  finalizedAt           DateTime?          @map("finalized_at")
  amendedAt             DateTime?          @map("amended_at")
  amendmentReason       String?            @map("amendment_reason")
  amendedById           String?            @map("amended_by_id")

  createdAt             DateTime           @default(now()) @map("created_at")

  consultation          Consultation       @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  clinic                Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient               Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                User               @relation("DoctorConsultationVersions", fields: [doctorId], references: [id], onDelete: Restrict)
  amendedBy             User?              @relation("AmendedByVersions", fields: [amendedById], references: [id], onDelete: SetNull)

  @@unique([consultationId, versionNumber])
  @@index([clinicId])
  @@index([patientId])
  @@index([consultationId])
  @@map("consultation_versions")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  BANK_TRANSFER
  INSURANCE
  OTHER
}

enum InvoiceItemType {
  CONSULTATION
  PROCEDURE
  MEDICATION
  LAB
  MISC
}

model InvoiceSequence {
  id           String   @id @default(uuid())
  clinicId     String   @map("clinic_id")
  year         Int
  lastSequence Int      @default(0) @map("last_sequence")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year])
  @@index([clinicId])
  @@map("invoice_sequences")
}

model Invoice {
  id             String        @id @default(uuid())
  clinicId       String        @map("clinic_id")
  patientId      String        @map("patient_id")
  appointmentId  String?       @map("appointment_id")
  consultationId String?       @map("consultation_id")
  createdById    String?       @map("created_by_id")

  invoiceNumber  String        @map("invoice_number")
  year           Int
  currency       String        @default("INR") // Snapshotted from Clinic.currency ("INR" or "NPR")
  status         InvoiceStatus @default(DRAFT)

  subtotal       Decimal       @default(0.00) @map("subtotal") @db.Decimal(12, 2)
  discount       Decimal       @default(0.00) @map("discount") @db.Decimal(12, 2)
  taxRate        Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)

  issueDate      DateTime?     @map("issue_date")
  dueDate        DateTime?     @map("due_date")
  notes          String?

  taxLabel       String?       @map("tax_label")
  taxNumber      String?       @map("tax_number")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items          InvoiceItem[]
  payments       Payment[]
  notifications  NotificationLog[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, year])
  @@index([appointmentId])
  @@index([consultationId])
  @@index([createdById])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  itemType    InvoiceItemType @default(MISC) @map("item_type")
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(uuid())
  clinicId       String        @map("clinic_id")
  invoiceId      String        @map("invoice_id")
  amount         Decimal       @map("amount") @db.Decimal(12, 2)
  method         PaymentMethod
  transactionRef String?       @map("transaction_ref")
  notes          String?
  receivedById   String?       @map("received_by_id")
  receivedAt     DateTime      @default(now()) @map("received_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy     User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  notifications  NotificationLog[]

  @@index([clinicId, invoiceId])
  @@index([clinicId, receivedAt])
  @@index([receivedById])
  @@map("payments")
}

// ─── PATIENT COMMUNICATIONS & NOTIFICATIONS ──────────────────────────────

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum NotificationEventType {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  PRESCRIPTION_READY
  PAYMENT_RECEIPT
  INVOICE_ISSUED
  GENERAL_ANNOUNCEMENT
}

model ClinicNotificationSetting {
  id                 String   @id @default(uuid())
  clinicId           String   @unique @map("clinic_id")
  smsEnabled         Boolean  @default(true) @map("sms_enabled")
  whatsappEnabled    Boolean  @default(true) @map("whatsapp_enabled")
  appointmentAlerts  Boolean  @default(true) @map("appointment_alerts")
  prescriptionAlerts Boolean  @default(true) @map("prescription_alerts")
  billingAlerts      Boolean  @default(true) @map("billing_alerts")
  senderName         String?  @map("sender_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_notification_settings")
}

model NotificationLog {
  id                String                @id @default(uuid())
  clinicId          String                @map("clinic_id")
  patientId         String                @map("patient_id")
  appointmentId     String?               @map("appointment_id")
  prescriptionId    String?               @map("prescription_id")
  invoiceId         String?               @map("invoice_id")
  paymentId         String?               @map("payment_id")
  channel           NotificationChannel
  eventType         NotificationEventType @map("event_type")
  recipientPhone    String                @map("recipient_phone")
  messageBody       String                @map("message_body")
  status            NotificationStatus    @default(PENDING)
  providerMessageId String?               @map("provider_message_id")
  providerName      String                @default("MOCK") @map("provider_name")
  errorMessage      String?               @map("error_message")
  sentAt            DateTime?             @map("sent_at")
  deliveredAt       DateTime?             @map("delivered_at")
  createdById       String?               @map("created_by_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  clinic            Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient           Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment       Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescription      Prescription?         @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment           Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy         User?                 @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@index([clinicId, eventType])
  @@map("notification_logs")
}

model SecureDocumentLink {
  id             String    @id @default(uuid())
  clinicId       String    @map("clinic_id")
  patientId      String    @map("patient_id")
  tokenHash      String    @unique @map("token_hash")
  resourceType   String    @map("resource_type") // "PRESCRIPTION" | "INVOICE" | "RECEIPT"
  resourceId     String    @map("resource_id")
  expiresAt      DateTime  @map("expires_at")
  accessCount    Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([clinicId, resourceId])
  @@map("secure_document_links")
}

