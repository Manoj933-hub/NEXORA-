// Prisma Schema Configuration for NEXORA
// Compatible with Prisma 6.19.3 and PostgreSQL 17

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicRole {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
  STAFF
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String
  phone         String?
  isActive      Boolean      @default(true) @map("is_active")
  emailVerified DateTime?    @map("email_verified")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  memberships   Membership[]
  sessions      Session[]
  appointments  Appointment[]

  @@index([email])
  @@map("users")
}

model Clinic {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  country     String       @default("IN") // "IN" for India, "NP" for Nepal
  currency    String       @default("INR") // "INR" or "NPR"
  phone       String?
  address     String?
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships  Membership[]
  sessions     Session[]
  patients     Patient[]
  appointments Appointment[]

  @@index([slug])
  @@map("clinics")
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Patient {
  id               String        @id @default(uuid())
  clinicId         String        @map("clinic_id")
  mrn              String        // Medical Record Number / Patient Identifier within clinic (e.g. NX-0001)
  name             String
  dateOfBirth      DateTime?     @map("date_of_birth")
  gender           String?       // MALE, FEMALE, OTHER
  phone            String?
  email            String?
  address          String?
  emergencyContact String?       @map("emergency_contact")
  bloodGroup       String?       @map("blood_group")
  allergies        String?
  notes            String?
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments     Appointment[]

  @@unique([clinicId, mrn])
  @@index([clinicId])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@index([clinicId, isActive])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(uuid())
  clinicId        String            @map("clinic_id")
  patientId       String            @map("patient_id")
  doctorId        String?           @map("doctor_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  cancelledReason String?           @map("cancelled_reason")
  checkedInAt     DateTime?         @map("checked_in_at")
  inProgressAt    DateTime?         @map("in_progress_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          User?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([clinicId, startTime])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([doctorId, startTime])
  @@map("appointments")
}

model Membership {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  clinicId  String     @map("clinic_id")
  role      ClinicRole @default(STAFF)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
  @@map("memberships")
}

model Session {
  id             String    @id @default(uuid())
  tokenHash      String    @unique @map("token_hash") // SHA-256 hash of raw session token
  userId         String    @map("user_id")
  activeClinicId String?   @map("active_clinic_id")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClinic   Clinic?   @relation(fields: [activeClinicId], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model AuthRateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  attempts  Int      @default(1)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key, resetAt])
  @@map("auth_rate_limits")
}
